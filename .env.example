# Server
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=ledger_db

# Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production

# Bootstrapping (Initial Admin User)
